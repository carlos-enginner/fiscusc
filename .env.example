# ============================================================================
# Fiscus-C - Configurações do Sistema
# ============================================================================

# Database
# URL de conexão com PostgreSQL (com pgvector)
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://fiscusc:fiscusc@localhost:5432/fiscusc

# Ollama
# URL base do servidor Ollama (local ou remoto)
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Provider
# Provider de embeddings: "ollama" (local, mais lento) ou "fastembed" (CPU, mais rápido)
# Ollama: usa qwen3-embedding via API do Ollama
# FastEmbed: usa modelos ONNX otimizados para CPU, sem servidor
EMBEDDING_PROVIDER=ollama

# Modelo para geração de embeddings (vetores semânticos)
# Ollama: qwen3-embedding:0.6b (1024 dimensões, ~600MB)
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Modelo para FastEmbed (usado quando EMBEDDING_PROVIDER=fastembed)
# Modelos multilíngue disponíveis:
#   - intfloat/multilingual-e5-large (1024 dims) - melhor qualidade, mesma dim do Ollama
#   - sentence-transformers/paraphrase-multilingual-mpnet-base-v2 (768 dims)
#   - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384 dims) - mais rápido
FASTEMBED_MODEL=intfloat/multilingual-e5-large

# LLM Provider
# Provider do modelo de linguagem: "ollama" (local) ou "gemini" (cloud)
LLM_PROVIDER=ollama

# Modelo de linguagem para geração de respostas
# Ollama: qwen3:8b, qwen3:4b, llama3:8b, etc.
# Gemini: gemini-2.0-flash, gemini-1.5-pro, etc.
LLM_MODEL=qwen3:8b

# Google Gemini (necessário se LLM_PROVIDER=gemini)
# Obter chave em: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=sua_chave_aqui
# LLM_MODEL=gemini-2.0-flash   # modelo Gemini a usar

# Aplicação
# Nível de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Tamanho máximo de cada chunk de texto (em caracteres)
# Menor = mais chunks, maior precisão na busca, mais custo de embedding
# Maior = menos chunks, busca mais ampla, menor custo
CHUNK_SIZE=1000

# Sobreposição entre chunks consecutivos (em caracteres)
# Evita perder contexto em quebras de chunk
CHUNK_OVERLAP=200

# Número máximo de chunks retornados na busca vetorial
# Mais resultados = mais contexto, mas resposta mais lenta
TOP_K_RESULTS=10

# Score mínimo de similaridade para considerar um chunk relevante (0.0-1.0)
# Menor = mais resultados, maior = apenas matches muito similares
MIN_SIMILARITY_SCORE=0.3

# Performance Tuning
# Número de chunks processados por batch durante ingestão (1-64)
# Maior = menos overhead de rede, mais memória usada
# GPU: 32-64 | CPU: 8-16
EMBEDDING_BATCH_SIZE=16

# Número de workers concorrentes para embeddings (1-32)
# Maior = mais rápido, mas consome mais VRAM/RAM
# GPU: 8-16 | CPU: 4-8
EMBEDDING_MAX_WORKERS=4

# Ativar cache LRU em memória de embeddings (true/false)
# Reutiliza embeddings de chunks idênticos entre documentos
# Reduz tempo de re-ingestão em ~90%
ENABLE_EMBEDDING_CACHE=true

# Ativar processamento incremental (true/false)
# Detecta e reutiliza chunks já existentes no banco
# Acelera ingestão de documentos similares em ~5-10x
ENABLE_INCREMENTAL_INGEST=true
